# Twilio Configuration (REQUIRED)
# Get these from https://console.twilio.com/
account_sid=your_twilio_account_sid_here
auth_token=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14787807480

# Webhook Base URL (REQUIRED)
# For local development, use ngrok or similar tunneling service
# Example: https://your-ngrok-url.ngrok.io
# Or use a public URL if deploying
WEBHOOK_BASE_URL=https://your-webhook-url.com

# AWS Configuration (OPTIONAL - Only if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET=ai-calling-agent
